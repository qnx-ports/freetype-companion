# Alpine-Contributor: Carlo Landmeter <clandmeter@alpinelinux.org>
# Alpine-Maintainer: Carlo Landmeter <clandmeter@alpinelinux.org>
# Maitainer: Aaron Bassett <abassett@blackberry.com
pkgname=freetype
pkgver=2.14.1
pkgrel=1
# upgrading needs to rebuild py3-matplotlib and update its _ftver
pkgdesc="TrueType font rendering library"
url="https://www.freetype.org/"
arch="all"
license="FTL OR GPL-2.0-or-later"
options="!check"
depends_dev="pkgconf brotli-dev bzip2-dev libpng-dev"
makedepends="meson ninja pkgconf-dev $depends_dev"
depends="
    brotli
    libbz2
    libpng
    zlib-ng
    "
subpackages="
    $pkgname-static
    $pkgname-dev
    "
source="
    https://download.savannah.gnu.org/releases/freetype/freetype-$pkgver.tar.xz
    pcf-family-names.patch
    subpixel.patch
    table-validation-modules.patch
    "

build() {
    meson setup build \
        -Dtests=enabled \
        -Dmmap=enabled \
        -Ddefault_library=both \
        --reconfigure \
        --buildtype=release \
        --prefix=/usr \
        
    ninja -C build

}

package() {
    DESTDIR="$pkgdir" ninja -C "$builddir"/build install
    install -Dm644 builds/unix/freetype2.m4 \
        -t "$pkgdir"/usr/share/aclocal
}

